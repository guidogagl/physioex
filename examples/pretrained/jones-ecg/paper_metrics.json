        "chat",
        "mesa",
        "wsc"
      ],
      "note": "headline: median over the 500 test recordings (0.7248)"
    },
    {
      "dataset": "ccshs",
      "condition": "ecg",
      "value": 0.8136
    },
    {
      "dataset": "cfs",
      "condition": "ecg",
      "value": 0.763
    },
    {
      "dataset": "chat",
      "condition": "ecg",
      "value": 0.7794
    },
    {
      "dataset": "mesa",
      "condition": "ecg",
      "value": 0.675
    },
    {
      "dataset": "wsc",
      "condition": "ecg",
